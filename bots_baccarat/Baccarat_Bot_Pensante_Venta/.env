# =============================================
# CONFIGURACION BOT PENSANTE
# =============================================
# Estrategia: 1 = Predeterminado (Martingala Rotante) | 2 = Modo Seguro (Recuperacion Plana $0.40)
GAME_MODE=1

# Apuestas automaticas
AUTO_BET_ENABLED=true
AUTO_BET_BASE_BET=0.20
AUTO_BET_BASE_CHIP=0.20
AUTO_BET_BASE_CLICKS=1
AUTO_BET_MAX_STEPS=10

# Telegram (Opcional - dejar vacio si no se usa)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Parametros de analisis
STARTUP_DELAY=60
MIN_SIGNAL_DELAY=2
MAX_SIGNAL_DELAY=6
MIN_CONFIDENCE_THRESHOLD=88
STOP_LOSS=-40.0
AUTO_BET_STOP_LOSS=-40.0
TAKE_PROFIT=50.0
AUTO_BET_TAKE_PROFIT=50.0
CONSECUTIVE_LOSS_LIMIT=5
